{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["jest", "node"],
    "paths": {
      "mongoose": ["../backend/node_modules/mongoose"]
    }
  },
  "include": ["**/*.ts"]
}
